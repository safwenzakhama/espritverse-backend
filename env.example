# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False

# Database (Railway automatically provides DATABASE_URL when you have PostgreSQL service)
# No need to set database variables manually - Railway handles this automatically

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Settings (add your frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Security Settings
ALLOWED_HOSTS=your-backend-domain.railway.app
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Email Settings (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
